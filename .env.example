# ============================================================
# Jirou — variables d'environnement (copier en .env)
# ============================================================

# ---- PostgreSQL ----
POSTGRES_USER=jirou
POSTGRES_PASSWORD=jirou_dev_password
POSTGRES_DB=jirou
POSTGRES_HOST=db
# Port publié côté HÔTE (pour se connecter avec un client externe).
# 5433 par défaut pour éviter un conflit avec un PostgreSQL local sur 5432.
# En interne (réseau Docker), la DB reste sur 5432 (cf. DATABASE_URL).
POSTGRES_PORT=5433

# URL complète consommée par le backend (SQLAlchemy).
# En local hors Docker, remplacer "db" par "localhost".
DATABASE_URL=postgresql+psycopg://jirou:jirou_dev_password@db:5432/jirou

# ---- Backend / FastAPI ----
# Port publié côté HÔTE (8010 pour éviter un conflit avec un service local sur 8000).
# En interne (réseau Docker) le backend écoute toujours sur 8000.
BACKEND_PORT=8010
# Origines autorisées CORS (séparées par des virgules) — doit matcher l'URL du front.
CORS_ORIGINS=http://localhost:5199

# ---- Auth / JWT ----
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- RAG / chatbot (Qdrant + Mistral) ----
# Port hôte publié pour Qdrant (interne : qdrant:6333).
QDRANT_PORT=6335
QDRANT_URL=http://qdrant:6333
# Clé API Mistral (LLM de réponse + embeddings mistral-embed). REQUISE pour le chatbot.
MISTRAL_API_KEY=
MISTRAL_API_BASE=https://api.mistral.ai
MISTRAL_CHAT_MODEL=mistral-small-latest
MISTRAL_EMBED_MODEL=mistral-embed
RAG_COLLECTION=jirou_rag

# ---- Frontend / Vite ----
# Port publié côté HÔTE (5199 pour éviter un conflit avec un service local sur 5173).
# En interne le dev server Vite écoute toujours sur 5173.
FRONTEND_PORT=5199
# URL du backend vue par le NAVIGATEUR = port hôte du backend.
VITE_API_URL=http://localhost:8010
