# ============================================================
# Jirou frontend — variables Vite (copier en .env.local)
# La source de vérité reste le .env.example racine du monorepo.
# Seules les variables prefixees VITE_ sont exposees au client.
# ============================================================

# URL de base de l'API backend (FastAPI). Les routes metier sont
# prefixees par /api/v1 cote client (voir src/lib/api.ts).
VITE_API_URL=http://localhost:8000
