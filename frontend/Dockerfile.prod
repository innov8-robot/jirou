# Build de production du frontend Jirou (fichiers statiques).
# VITE_API_URL est figé au moment du build.
FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci
COPY . .
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build
# Résultat dans /app/dist
